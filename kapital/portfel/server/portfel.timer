# /etc/systemd/system/portfel.timer
# Working days at 08, 09, 10, 12 and 14 Tashkent time. A run after a success does
# nothing; after 14:00 nobody tries again — that day has no portfel.
[Unit]
Description=Portfel tries on working days

[Timer]
OnCalendar=Mon..Fri *-*-* 08,09,10,12,14:00:00 Asia/Tashkent
Persistent=true

[Install]
WantedBy=timers.target
